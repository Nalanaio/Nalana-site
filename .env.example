# ── Backend API (must match IDE NALANA_API_BASE — no trailing slash) ──
# Same base on IDE + website = one user_id for login on both sides.
# Auth: login, register, refresh, forgot-password, reset-password
# Users: GET/PATCH /v1/users/me; usage: GET /v1/usage/me

# Production
NALANA_API_BASE=https://nalana-backend-production.up.railway.app
VITE_NALANA_API_BASE=https://nalana-backend-production.up.railway.app

# Staging — get URL from the team, then set both vars to that URL

# Website proxies auth via /api/auth/* (server-side); do not call the backend
# from the browser with a different base than the IDE.

# Backend owns download notifications; website never sends them.
# Keep all new rollout flags disabled until local integration/runtime acceptance.
NALANA_FUNNEL_ENABLED=false
PUBLIC_NALANA_FUNNEL_ENABLED=false
# Google Analytics/RB2B use this opt-in gate. Vercel Web Analytics also requires
# usage consent and the canonical https://nalana.io or https://www.nalana.io origin.
# Keep false on dev; preview/localhost never inject Vercel Analytics even if true.
PUBLIC_NALANA_VENDOR_ANALYTICS_ENABLED=false
NALANA_ACQUISITION_RELAY=false
NALANA_ACQUISITION_PAIRING=false
SITE_ACQUISITION_REPORTS_ENABLED=false
# Private service/cookie credentials; never use PUBLIC_ or VITE_ prefixes.
NALANA_WEBSITE_SERVICE_TOKEN=
NALANA_FUNNEL_COOKIE_SECRET=
NALANA_DOWNLOAD_COOKIE_KEYS=
NALANA_DOWNLOAD_COOKIE_KEY_ID=
NALANA_DOWNLOAD_RELAY_BASE=
# Must exactly equal target backend APP_ENV, no inferred production identity.
NALANA_ENVIRONMENT=
NALANA_WEBSITE_BUILD_ID=
OPERATOR_ALLOWED_ACCOUNT_IDS=
OPERATOR_SESSION_KEY=
RUN_VIEWER_ADMIN_TOKEN=

# ── Backend API (must match IDE NALANA_API_BASE — no trailing slash) ──
# Same base on IDE + website = one user_id for login on both sides.
# Auth: login, register, refresh, forgot-password, reset-password
# Users: GET/PATCH /v1/users/me; usage: GET /v1/usage/me

# Production
NALANA_API_BASE=https://nalana-backend-production.up.railway.app
VITE_NALANA_API_BASE=https://nalana-backend-production.up.railway.app

# Staging — get URL from the team, then set both vars to that URL

# Website proxies auth via /api/auth/* (server-side); do not call the backend
# from the browser with a different base than the IDE.
